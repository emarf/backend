{
  "name": "tickets-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:psql": "docker compose exec postgres psql -U app -d tickets",
    "check:sql": "node tools/check-sql.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "8.15.5"
  }
}
