{
  "name": "tickets-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:psql": "docker compose exec postgres psql -U app -d tickets",
    "check:sql": "node tools/check-sql.ts",
    "api:dev": "pnpm --filter tickets-api start:dev",
    "test:api": "pnpm --filter tickets-api test:e2e",
    "format": "prettier --write \"api/**/*.ts\" \"tools/**/*.ts\"",
    "format:check": "prettier --check \"api/**/*.ts\" \"tools/**/*.ts\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "8.15.5",
    "prettier": "3.9.10"
  }
}
